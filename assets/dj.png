",null,{\"className\":\"seo-video\",\"children\":[\"$\",\"$L18\",null,{\"videoId\":\"pL6pmdlwVLI\",\"title\":\"DJ Boringer v01\"}]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"b:[\"$\",\"$L19\",null,{}]\nc:[\"$\",\"section\",null,{\"className\":\"tillid-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"tillid-grid\",\"children\":[[\"$\",\"div\",null,{\"className\":\"tillid-card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"tillid-card-badge\",\"children\":[\"$\",\"i\",null,{\"className\":\"fas fa-building-columns\",\"aria-hidden\":\"true\"}]}],[\"$\",\"div\",null,{\"className\":\"tillid-card-text\",\"children\":[[\"$\",\"p\",null,{\"className\":\"tillid-card-eyebrow\",\"children\":\"BRANCHEFORENING\"}],[\"$\",\"h3\",null,{\"children\":\"Medlem af Danske Borefirmaer\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"tillid-card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"tillid-card-badge\",\"children\":[\"$\",\"i\",null,{\"className\":\"fas fa-file-signature\",\"aria-hidden\":\"true\"}]}],[\"$\",\"div\",null,{\"className\":\"tillid-card-text\",\"children\":[[\"$\",\"p\",null,{\"className\":\"tillid-card-eyebrow\",\"children\":\"DI / 3F\"}],[\"$\",\"h3\",null,{\"children\":\"Overenskomstdækket virksomhed\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"tillid-card\",\"children\":[[\"$\",\"div\",null,{\"className\":\"tillid-card-badge\",\"children\":[\"$\",\"i\",null,{\"className\":\"fas fa-trophy\",\"aria-hidden\":\"true\"}]}],[\"$\",\"div\",null,{\"className\":\"tillid-card-text\",\"children\":[[\"$\",\"p\",null,{\"className\":\"tillid-card-eyebrow\",\"children\":\"VÆKSTVIRKSOMHED\"}],[\"$\",\"h3\",null,{\"children\":\"Børsen Gazelle\"}]]}]]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"d:[\"$\",\"section\",null,{\"className\":\"seo-section seo-section-reverse\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"seo-grid\",\"children\":[[\"$\",\"div\",null,{\"className\":\"seo-image\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/forside-4.jpg\",\"alt\":\"DJ Boringer borearbejde til byggeri\"}]}],[\"$\",\"div\",null,{\"className\":\"seo-content\",\"children\":[[\"$\",\"p\",null,{\"className\":\"section-label\",\"children\":\"ERHVERV \u0026 RÅDGIVERE\"}],[\"$\",\"h2\",null,{\"children\":[\"Boringer til byggeri\",[\"$\",\"br\",null,{}],\"og anlægsprojekter\"]}],[\"$\",\"div\",null,{\"className\":\"seo-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"Vi udfører boringer for erhverv, entreprenører og rådgivende ingeniører, der har brug for præcise data til planlægning og projektering. De geotekniske boringer giver indsigt i jordens bæreevne, stabilitet og funderingsforhold, mens miljøboringer bruges til kortlægning og afgrænsning af forurening. De hydro- og geologiske boringer anvendes til vurdering af vandtryk, lagfølge og dræningsbehov i forbindelse med anlægsprojekter.\"}],[\"$\",\"p\",null,{\"children\":\"Samarbejdet med rådgivere og miljøteknikere er en fast del af vores hverdag. Vi tilpasser hver opgave til projektets formål og udfører boringerne effektivt og dokumenteret, så data kan bruges direkte i rapportering og analyser.\"}],[\"$\",\"p\",null,{\"children\":\"Hos DJ Boringer kombinerer vi erfaring med moderne boreteknik. Vores udstyr muliggør boring i ler, sand, grus og moræneler med minimal forstyrrelse af lagene, så resultaterne forbliver nøjagtige. Det gør os til en stabil samarbejdspartner i komplekse bygge- og miljøprojekter.\"}]]}],[\"$\",\"div\",null,{\"className\":\"cta-buttons\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#kontakt\",\"className\":\"btn-primary\",\"children\":\"Kontakt\"}],[\"$\",\"$L4\",null,{\"href\":\"/profil/\",\"className\":\"btn-secondary\",\"children\":\"Læs mere\"}]]}]]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"e:[\"$\",\"section\",null,{\"className\":\"seo-section\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"seo-grid\",\"children\":[[\"$\",\"div\",null,{\"className\":\"seo-content\",\"children\":[[\"$\",\"p\",null,{\"className\":\"section-label\",\"children\":\"KVALITET \u0026 ERFARING\"}],[\"$\",\"h2\",null,{\"children\":[\"Et solidt fundament\",[\"$\",\"br\",null,{}],\"for dit projekt\"]}],[\"$\",\"div\",null,{\"className\":\"seo-prose\",\"children\":[[\"$\",\"p\",null,{\"children\":\"DJ Boringer A/S er et dansk borefirma med mange års erfaring inden for geotekniske, hydrogeologiske og miljøtekniske boringer. Vi ved, at feltdata skal være til at stole på, og derfor arbejder vi konsekvent med kvalitet, orden og dokumentation i alle faser af projektet.\"}],[\"$\",\"p\",null,{\"children\":\"Vi tilbyder borearbejde og feltdata, der kan bruges i projektering, funderingsberegninger og miljøvurderinger. Hver boring udføres med fokus på præcision, og alle prøver håndteres og registreres efter gældende retningslinjer.\"}],[\"$\",\"p\",null,{\"children\":\"Som samarbejdspartner lægger vi vægt på dialog og fleksibilitet. Vi ved, at hvert projekt er unikt, og derfor tilpasser vi metode, boreprogram og logistik, så arbejdet gennemføres effektivt.\"}],[\"$\",\"p\",null,{\"children\":\"Med DJ Boringer A/S får du en partner, der leverer borearbejde, dokumentation og feltdata, du kan regne med. Vi gør det første skridt i byggeprocessen sikkert og sørger for, at du står på et solidt fundament.\"}]]}],[\"$\",\"div\",null,{\"className\":\"cta-buttons\",\"children\":[[\"$\",\"a\",null,{\"href\":\"#kontakt\",\"className\":\"btn-primary\",\"children\":\"Kontakt\"}],[\"$\",\"$L4\",null,{\"href\":\"/profil/\",\"className\":\"btn-secondary\",\"children\":\"Læs mere\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"seo-image\",\"children\":[\"$\",\"img\",null,{\"src\":\"/images/dji-0186.jpg\",\"alt\":\"DJ Boringer borearbejde i felten\"}]}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"f:[\"$\",\"section\",null,{\"className