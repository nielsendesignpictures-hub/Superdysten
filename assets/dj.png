"className\":\"contact-bottom-grid\",\"children\":[[\"$\",\"div\",null,{\"className\":\"contact-info\",\"children\":[[\"$\",\"p\",null,{\"className\":\"section-label\",\"children\":\"KONTAKT OS\"}],[\"$\",\"h2\",null,{\"children\":\"Få hjælp til dit næste byggeprojekt\"}],[\"$\",\"p\",null,{\"children\":\"Har du brug for en erfaren og pålidelig samarbejdspartner til dit næste projekt? DJ Boringer A/S udfører geotekniske, miljøtekniske og geologiske boringer over hele landet og leverer resultater, du kan stole på. Med mange års erfaring i branchen sikrer vi, at du får præcise data og et solidt beslutningsgrundlag, uanset om det handler om jordbundsundersøgelser, forureningsboringer eller dybe geotekniske prøver.\"}],[\"$\",\"p\",null,{\"children\":\"Vores team står klar til at rådgive dig om den bedste løsning til netop dit projekt og sørger for en tryg proces fra start til slut. Kontakt os i dag for en uforpligtende samtale – vi hjælper dig med at skabe et sikkert fundament for dit byggeri.\"}],[\"$\",\"a\",null,{\"href\":\"tel:+4553510800\",\"className\":\"info-item info-item-link\",\"children\":[[\"$\",\"i\",null,{\"className\":\"fas fa-phone\"}],\" \",[\"$\",\"strong\",null,{\"children\":\"+45 53 51 08 00\"}]]}],[\"$\",\"a\",null,{\"href\":\"mailto:salg@djboringer.dk\",\"className\":\"info-item info-item-link\",\"children\":[[\"$\",\"i\",null,{\"className\":\"fas fa-envelope\"}],\" \",\"salg@djboringer.dk\"]}],[\"$\",\"div\",null,{\"className\":\"info-item\",\"children\":[[\"$\",\"i\",null,{\"className\":\"fas fa-location-dot\"}],\" \",\"Raasigvangen 9, 3550 Slangerup\"]}]]}],[\"$\",\"$L35\",null,{\"variant\":\"bottom\",\"siteKey\":\"djboringer-dk\",\"apiUrl\":\"https://xyz1234wasd9876.kontaktformular.dk/submit.php\",\"ownerFirstName\":\"DJ Boringer\"}]]}]}]}]\n"])</script><script>self.__next_f.push([1,"11:[\"$\",\"footer\",null,{\"className\":\"footer\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[[\"$\",\"div\",null,{\"className\"